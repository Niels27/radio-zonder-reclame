{
  "name": "dutch-radio-ad-break-switcher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A minimalistic web application that plays Dutch radio stations and automatically switches to user playlists during ad breaks",
  "author": "Niels",
  "homepage": "https://niels27.github.io/no-ads-radio-project/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Niels27/no-ads-radio-project.git"
  },
  "bugs": {
    "url": "https://github.com/Niels27/no-ads-radio-project/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && npm run preview",
    "build:github": "vite build --base=/no-ads-radio-project/",
    "deploy:github": "npm run build:github && echo 'Build completed for GitHub Pages'",
    "predeploy": "npm run build:github",
    "test:build": "npm run build && npm run preview"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.0",
    "terser": "^5.40.0",
    "vite": "^6.3.5"
  }
}
