# Firebase Configuration (optional - for production deployment)
# Get these values from Firebase Console: https://console.firebase.google.com/
# See FIREBASE_SETUP.md for detailed setup instructions

# If you don't set these up, the app will run in demo mode (localStorage only)
# This is fine for development, but for production you should set up Firebase

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
